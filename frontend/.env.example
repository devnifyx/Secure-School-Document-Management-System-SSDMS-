# Base URL of the deployed Laravel backend API (no trailing slash).
# Leave unset for local development — Vite's dev proxy (see vite.config.ts)
# forwards /api requests to http://127.0.0.1:8000 automatically.
#
# Example for production (Vercel, etc.):
# VITE_API_URL=https://api.your-domain.com
VITE_API_URL=
